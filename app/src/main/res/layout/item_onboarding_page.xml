<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="4dp"
    android:paddingBottom="20dp">

    <!-- Step Badge -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_streak_pill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginTop="30dp"
        android:paddingHorizontal="14dp"
        android:paddingVertical="5dp">

        <View
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:background="@drawable/bg_primary_button" />

        <TextView
            android:id="@+id/tvBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="STEP 01 OF 04 • FOUNDATIONS"
            android:textColor="#0891B2"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Illustration / Card with Top Margin -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="50dp"
        android:layout_marginHorizontal="8dp"
        app:cardBackgroundColor="@color/surface_light"
        app:cardCornerRadius="20dp"
        app:cardElevation="5dp"
        app:cardMaxElevation="3dp"
        app:strokeColor="#FBFBFB"
        app:strokeWidth="1.5dp">

        <ImageView
            android:id="@+id/ivIllustration"
            android:layout_width="match_parent"
            android:layout_height="240dp"
            android:background="@drawable/bg_card_surface"
            android:contentDescription="@string/app_name"
            android:scaleType="centerCrop"
            android:adjustViewBounds="true"
            android:src="@drawable/onboarding_step_2_cloud_sandbox" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Title -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="26dp"
        android:gravity="center"
        android:text="Master Real AI from Scratch"
        android:textColor="@color/text_primary_light"
        android:textSize="24sp"
        android:textStyle="bold" />

    <!-- Subtitle -->
    <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:lineSpacingExtra="2dp"
        android:text="Go beyond basic tutorials. Build intuition in Python, machine learning, neural architectures, and transformer math with structured pathways."
        android:textColor="@color/text_secondary_light"
        android:textSize="13sp" />

    <!-- Feature Chips Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/chip1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_card_surface"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            android:text="✓ Interactive Code Labs"
            android:textColor="@color/text_primary_light"
            android:textSize="11.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/chip2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_card_surface"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            android:text="✓ Bilingual"
            android:textColor="@color/text_primary_light"
            android:textSize="11.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/chip3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_surface"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            android:text="✓ Milestones"
            android:textColor="@color/text_primary_light"
            android:textSize="11.5sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
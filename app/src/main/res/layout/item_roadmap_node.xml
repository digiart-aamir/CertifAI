<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="280dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="12dp"
    android:background="@drawable/bg_card_surface"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Node Stage Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvNodeStage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#122563EB"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="STAGE 1"
            android:textColor="@color/electric_blue"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvNodeStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="#1210B981"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="✓ COMPLETED"
            android:textColor="#10B981"
            android:textSize="10sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tvNodeReward"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🪙 +50"
            android:textColor="@color/gold_badge"
            android:textSize="12sp"
            android:textStyle="bold" />

    </LinearLayout>

    <TextView
        android:id="@+id/tvNodeTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Python for AI &amp; CS Fundamentals"
        android:textColor="@color/text_primary_light"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvNodeDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="Master core Python syntax, OOP, Pyodide execution, and memory stack."
        android:textColor="@color/text_secondary_light"
        android:textSize="12sp" />

    <!-- Progress Bar -->
    <ProgressBar
        android:id="@+id/pbNodeProgress"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="12dp"
        android:max="100"
        android:progress="100"
        android:progressDrawable="@drawable/bg_primary_button" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvNodeLessonsCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="8 / 8 Lessons"
            android:textColor="@color/text_secondary_light"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tvNodeAction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Explore Node →"
            android:textColor="@color/electric_blue"
            android:textSize="12sp"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/llFloatingDock"
    android:layout_width="wrap_content"
    android:layout_height="64dp"
    android:background="@drawable/bg_floating_dock"
    android:elevation="16dp"
    android:gravity="center"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="8dp">

    <!-- Home Tab -->
    <ImageButton
        android:id="@+id/btnNavHome"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginHorizontal="4dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Home"
        android:src="@android:drawable/ic_menu_today"
        app:tint="@color/cyan_accent_bright" />

    <!-- Learn Tab -->
    <ImageButton
        android:id="@+id/btnNavLearn"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginHorizontal="4dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Learn"
        android:src="@android:drawable/ic_menu_compass"
        app:tint="@color/text_secondary_dark" />

    <!-- Explore Tab -->
    <ImageButton
        android:id="@+id/btnNavExplore"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginHorizontal="4dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Explore"
        android:src="@android:drawable/ic_menu_search"
        app:tint="@color/text_secondary_dark" />

    <!-- Certificates Tab -->
    <ImageButton
        android:id="@+id/btnNavCertificates"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginHorizontal="4dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Certificates"
        android:src="@android:drawable/ic_menu_agenda"
        app:tint="@color/text_secondary_dark" />

    <!-- Profile Tab -->
    <ImageButton
        android:id="@+id/btnNavProfile"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginHorizontal="4dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Profile"
        android:src="@android:drawable/ic_menu_myplaces"
        app:tint="@color/text_secondary_dark" />

</LinearLayout>
<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/splashFragment">

    <fragment
        android:id="@+id/splashFragment"
        android:name="com.asbots.certifai.ui.SplashFragment"
        android:label="Splash"
        tools:layout="@layout/fragment_splash">
        <action
            android:id="@+id/action_splashFragment_to_onboardingFragment"
            app:destination="@id/onboardingFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/onboardingFragment"
        android:name="com.asbots.certifai.ui.OnboardingFragment"
        android:label="Onboarding"
        tools:layout="@layout/fragment_onboarding">
        <action
            android:id="@+id/action_onboardingFragment_to_loginFragment"
            app:destination="@id/loginFragment" />
    </fragment>

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.asbots.certifai.ui.LoginFragment"
        android:label="Login"
        tools:layout="@layout/fragment_login">
        <action
            android:id="@+id/action_loginFragment_to_registerFragment"
            app:destination="@id/registerFragment" />
        <action
            android:id="@+id/action_loginFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/registerFragment"
        android:name="com.asbots.certifai.ui.RegisterFragment"
        android:label="Register"
        tools:layout="@layout/fragment_register">
        <action
            android:id="@+id/action_registerFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/registerFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.asbots.certifai.HomeFragment"
        android:label="Home"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_homeFragment_to_courseDetailFragment"
            app:destination="@id/courseDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/learnFragment"
        android:name="com.asbots.certifai.ui.LearnFragment"
        android:label="Learn"
        tools:layout="@layout/fragment_learn" />

    <fragment
        android:id="@+id/exploreFragment"
        android:name="com.asbots.certifai.ui.ExploreFragment"
        android:label="Explore"
        tools:layout="@layout/fragment_explore">
        <action
            android:id="@+id/action_exploreFragment_to_courseDetailFragment"
            app:destination="@id/courseDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/certificatesFragment"
        android:name="com.asbots.certifai.ui.CertificatesFragment"
        android:label="Certificates"
        tools:layout="@layout/fragment_certificates">
        <action
            android:id="@+id/action_certificatesFragment_to_certificateDetailFragment"
            app:destination="@id/certificateDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.asbots.certifai.ui.ProfileFragment"
        android:label="Profile"
        tools:layout="@layout/fragment_profile" />

    <fragment
        android:id="@+id/courseDetailFragment"
        android:name="com.asbots.certifai.ui.CourseDetailFragment"
        android:label="Course Detail"
        tools:layout="@layout/fragment_course_detail">
        <argument
            android:name="courseId"
            app:argType="string"
            android:defaultValue="course_1" />
        <action
            android:id="@+id/action_courseDetailFragment_to_coursePlayerFragment"
            app:destination="@id/coursePlayerFragment" />
        <action
            android:id="@+id/action_courseDetailFragment_to_quizFragment"
            app:destination="@id/quizFragment" />
        <action
            android:id="@+id/action_courseDetailFragment_to_projectFragment"
            app:destination="@id/projectFragment" />
    </fragment>

    <fragment
        android:id="@+id/coursePlayerFragment"
        android:name="com.asbots.certifai.ui.CoursePlayerFragment"
        android:label="Course Player"
        tools:layout="@layout/fragment_course_player">
        <argument
            android:name="courseId"
            app:argType="string"
            android:defaultValue="course_1" />
    </fragment>

    <fragment
        android:id="@+id/quizFragment"
        android:name="com.asbots.certifai.ui.QuizFragment"
        android:label="Quiz"
        tools:layout="@layout/fragment_quiz">
        <argument
            android:name="courseId"
            app:argType="string"
            android:defaultValue="course_1" />
    </fragment>

    <fragment
        android:id="@+id/projectFragment"
        android:name="com.asbots.certifai.ui.ProjectFragment"
        android:label="Project"
        tools:layout="@layout/fragment_project">
        <argument
            android:name="courseId"
            app:argType="string"
            android:defaultValue="course_1" />
    </fragment>

    <fragment
        android:id="@+id/certificateDetailFragment"
        android:name="com.asbots.certifai.ui.CertificateDetailFragment"
        android:label="Certificate Detail"
        tools:layout="@layout/fragment_certificate_detail">
        <argument
            android:name="certId"
            app:argType="string"
            android:defaultValue="cert_1" />
    </fragment>

</navigation>